    "# Increase global font size\n",
    "plt.rcParams.update({'font.size': 22})  # Adjust the size as needed\n",
    "the_fontsize = 24\n",
    "# Create a figure with subplots\n",
    "fig, ax = plt.subplots(2, 1, sharex=True, figsize=(15, 15))\n",
    "\n",
    "plt.subplots_adjust(wspace=0, hspace=0.07)\n",
    "\n",
    "ax[0].set_rasterized(True)\n",
    "\n",
    "# Plot the first panel (BNS)\n",
    "#im1 = ax[0].scatter(tides, mass, c=np.log10(prob), cmap='Purples', alpha=1.0)\n",
    "#im1 = ax[0].scatter(tides, mass, c=np.log10(prob), cmap='GnBu', alpha=1.0)\n",
    "im1 = ax[0].scatter(tides, mass, c=np.log10(prob), cmap='Blues', vmax=-3.5, vmin=-6., alpha=1.0)\n",
    "#plot.ax[0].clim(-4,4)\n",
    "\n",
    "\n",
    "ax[0].axhspan(1.42, 1.46, color='red', alpha=0.4)\n",
    "ax[0].annotate(r'\\textbf{GW190425}', (650, 1.49), fontsize=the_fontsize)\n",
    "ax[0].axhspan(1.186, 1.192, color='red', alpha=0.4)\n",
    "ax[0].annotate(r'\\textbf{GW170817}', (270, 1.22), color='white',fontsize=the_fontsize)\n",
    "ax[0].set_xlim(0, 1000)\n",
    "ax[0].set_ylim(min(mass), max(mass))\n",
    "ax[0].set_ylabel(r'$\\mathcal{M}\\,\\left[M_\\odot\\right]$',fontsize=the_fontsize)\n",
    "\n",
    "# fitting formulas for pdf L of M\n",
    "MM = np.linspace(0.8,2.1,100)\n",
    "# BNS case\n",
    "fitup  =-23+2690/MM**4.5\n",
    "fitlow =-56+583 /MM**3.9\n",
    "# contours with GW constraint\n",
    "fitup2  =-0.55+2091/MM**5.5\n",
    "fitlow2 =-41+539 /MM**4.5\n",
    "# BHNS case\n",
    "\n",
    "MM2 = np.linspace(0.8,3,100)\n",
    "fitup3  =-5+1700/MM2**4.9\n",
    "fitlow3 =-6+296/MM2**6.6\n",
    "# contours with GW constraint\n",
    "fitup4  =27.7+1100/MM2**6.7\n",
    "fitlow4 =61+124 /MM2**9.56\n",
    "\n",
    "ax[0].plot(fitup[:], MM[:], color=\"black\", linestyle=\"--\",linewidth=4)\n",
    "ax[0].plot(fitlow[:], MM[:], color=\"black\", linestyle=\"--\",linewidth=4)\n",
    "\n",
    "ax[0].plot(fitup2[:], MM[:], color=\"gray\", linestyle=\"--\",linewidth=4)\n",
    "ax[0].plot(fitlow2[:], MM[:], color=\"gray\", linestyle=\"--\",linewidth=4)\n",
    "\n",
    "ax[1].plot(fitup3[:], MM2[:], color=\"black\", linestyle=\"--\",linewidth=4)\n",
    "ax[1].plot(fitlow3[:], MM2[:], color=\"black\", linestyle=\"--\",linewidth=4)\n",
    "\n",
    "#ax[1].plot(fitup4[:], MM[:], color=\"gray\", linestyle=\"--\",linewidth=4)\n",
    "#ax[1].plot(fitlow4[:], MM[:], color=\"gray\", linestyle=\"--\",linewidth=4)\n",
    "\n",
    "#ax[1].plot(fitup2[:], MM[:], color=\"gray\", linestyle=\"--\",linewidth=4)\n",
    "#ax[1].plot(fitlow2[:], MM[:], color=\"gray\", linestyle=\"--\",linewidth=4)\n",
    "\n",
    "\n",
    "plt.text(850, 5.3, r'${\\rm \\textbf{BNS}}$', fontsize=30)\n",
    "\n",
    "# Add a color bar to the first subplot\n",
    "#fig.colorbar(im1, ax=ax[0], label=r'$\\rm \\log_{10}[\\pi(\\mathcal{M},\\,\\tilde{\\Lambda})]$')\n",
    "#fig.colorbar(im1, ax=ax[0])\n",
    "cb = fig.colorbar(im1, ax=ax[0])\n",
    "cb.set_label(label=r'$\\rm \\log_{10}[\\pi(\\mathcal{M},\\,\\tilde{\\Lambda})]$', fontsize=24)\n",
    "ax[1].set_rasterized(True)\n",
    "\n",
    "# Plot the second panel (NSBH)\n",
    "#im2 = ax[1].scatter(tides2, mass2, c=np.log10(prob2), cmap='Purples', alpha=1.0)\n",
    "#im2 = ax[1].scatter(tides2, mass2, c=np.log10(prob2), cmap='GnBu', alpha=1.0)\n",
    "im2 = ax[1].scatter(tides2, mass2, c=np.log10(prob2), cmap='Blues', vmax=-2.5, vmin=-6.5, alpha=1.0)\n",
    "ax[1].axhspan(1.42, 1.46, color='red', alpha=0.4)\n",
    "ax[1].annotate(r'\\textbf{GW190425}', (650, 1.49), fontsize=the_fontsize)\n",
    "ax[1].axhspan(6.09 - 0.06, 6.09 + 0.06, color='red', alpha=0.4)\n",
    "ax[1].annotate(r'\\textbf{GW190814}', (650, 6.11), fontsize=the_fontsize)\n",
    "ax[1].axhspan(1.94 - 0.04, 1.94 + 0.04, color='red', alpha=0.4)\n",
    "ax[1].annotate(r'\\textbf{GW230529}', (650, 2.02), fontsize=the_fontsize)\n",
    "ax[1].axhspan(2.58 - 0.007, 2.58 + 0.006, color='red', alpha=0.4)\n",
    "ax[1].annotate(r'\\textbf{GW200115}', (650, 2.62), fontsize=the_fontsize)\n",
    "ax[1].set_xlim(0, 1000)\n",
    "ax[1].set_ylim(min(mass2), max(mass2)+0.15)\n",
    "ax[1].set_ylabel(r'$\\mathcal{M}\\,\\left[M_\\odot\\right]$',fontsize=the_fontsize)\n",
    "ax[1].set_xlabel(r'$\\tilde{\\Lambda}$',fontsize=the_fontsize)\n",
    "\n",
    "plt.text(850, 2.9, r'${\\rm \\textbf{NSBH}}$', fontsize=30)\n",
    "\n",
    "# Adjust tick label font sizes\n",
    "for axis in ax:\n",
    "    axis.tick_params(axis='both', which='both', labelsize=the_fontsize)\n",
    "\n",
    "# Add a color bar to the second subplot\n",
    "#fig.colorbar(im2, ax=ax[1], label=r'$\\rm \\log_{10}[\\pi(\\mathcal{M},\\,\\tilde{\\Lambda})]$')\n",
    "cb = fig.colorbar(im2, ax=ax[1])\n",
    "cb.set_label(label=r'$\\rm \\log_{10}[\\pi(\\mathcal{M},\\,\\tilde{\\Lambda})]$', fontsize=24)\n",
    "\n",
    "# Adjust layout and save the figure\n",
    "#plt.tight_layout()\n",
    "plt.savefig('Fig_1_Physics_priors.pdf', dpi=200,bbox_inches='tight')\n",
    "plt.show()\n"
   ]
